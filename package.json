{
  "name": "new-living-design",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node scripts/test-badplaner.mjs",
    "typecheck:api": "tsc -p tsconfig.badplaner.json",
    "check:catalog": "node scripts/check-catalog.mjs",
    "dev": "vite",
    "build": "node scripts/fetch-swatches.mjs && tsc -b && vite build && node scripts/prerender.mjs",
    "build:spa": "tsc -b && vite build",
    "prerender": "node scripts/prerender.mjs",
    "build:prerender": "vite build --config vite.config.prerender.ts",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/react-helmet": "^6.1.11",
    "@vercel/analytics": "^1.5.0",
    "@vercel/og": "^0.8.5",
    "@vercel/speed-insights": "^1.2.0",
    "react": "^18.3.1",
    "react-cookie-consent": "^9.0.0",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.7.1",
    "vite-plugin-sitemap": "^0.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "sharp": "^0.35.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vite-plugin-prerender": "^1.0.8",
    "vite-plugin-ssr": "^0.4.142"
  }
}
